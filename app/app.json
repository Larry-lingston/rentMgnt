{
  "expo": {
    "name": "Rent Manager",
    "slug": "rent-management-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "rentmanager",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1a365d"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.rentmanager.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1a365d"
      },
      "package": "com.rentmanager.app"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-asset",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Rent Manager to access your photos for property listings.",
          "cameraPermission": "Allow Rent Manager to use your camera for property photos."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Rent Manager to use your location to pin properties on the map."
        }
      ]
    ]
  }
}
